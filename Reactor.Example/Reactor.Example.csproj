<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0</Version>
        <Description>Example mod using Reactor</Description>
        <Authors>NuclearPowered</Authors>
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <DisableUnmanagedBindingResolution>true</DisableUnmanagedBindingResolution>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reactor\Reactor.csproj" Private="false" />
    </ItemGroup>

    <Import Project="../AmongUs.props" />
</Project>
